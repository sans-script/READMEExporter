{
  "manifest_version": 3,
  "name": "Profile Exporter",
  "description": "Export a GitHub profile as a one-page resume PDF, or any README to PDF or HTML.",
  "version": "0.3.0",
  "permissions": ["debugger"],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Profile Exporter",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "css": [
        "src/content/print.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
