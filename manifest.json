{
  "manifest_version": 3,
  "name": "README Exporter",
  "description": "Export GitHub repository and profile READMEs to visually faithful PDF or HTML files.",
  "version": "0.1.2",
  "permissions": [],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "README Exporter",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "css": [
        "src/content/print.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
